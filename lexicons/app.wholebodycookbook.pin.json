{
  "lexicon": 1,
  "id": "app.wholebodycookbook.pin",
  "defs": {
    "main": {
      "type": "record",
      "description": "A pin placing a note, recipe, or Bluesky post onto a region of the body.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["region", "createdAt"],
        "properties": {
          "region": {
            "type": "string",
            "description": "Canonical body region id from the Whole Body Cookbook atlas.",
            "knownValues": ["crown", "brain", "face", "throat", "heart", "lungs", "solar-plexus", "stomach", "liver", "gallbladder", "spleen", "pancreas", "intestines", "kidneys", "adrenal", "spine", "pelvis", "womb", "left-arm", "right-arm", "hands", "left-leg", "right-leg", "feet", "skin", "blood", "autonomic", "whole"]
          },
          "side": { "type": "string", "knownValues": ["left", "right", "midline", "bilateral"] },
          "systems": {
            "type": "array",
            "items": { "type": "string", "knownValues": ["nervous", "meridian", "endocrine", "cardiovascular", "digestive", "respiratory", "immune", "musculoskeletal", "fascia", "lymph", "energetic"] }
          },
          "meridians": { "type": "array", "items": { "type": "string" } },
          "topics": { "type": "array", "items": { "type": "string" } },
          "text": { "type": "string", "maxGraphemes": 300, "maxLength": 3000 },
          "post": { "type": "string", "format": "at-uri" },
          "tags": { "type": "array", "items": { "type": "string", "maxGraphemes": 64, "maxLength": 640 } },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
